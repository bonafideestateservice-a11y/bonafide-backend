{
  "name": "bonafide-services",
  "version": "1.0.0",
  "description": "Modular, role-based Node.js + Express + TypeScript + Prisma API boilerplate",
  "main": "dist/server.js",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "test": "jest --runInBand",
    "format": "prettier --write \"src/**/*.ts\" \"postman/**/*.ts\" \"prisma/seed.ts\" \"*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"postman/**/*.ts\" \"prisma/seed.ts\" \"*.js\" \"*.json\"",
    "prisma:generate": "NODE_OPTIONS=--max_old_space_size=4096 npx prisma generate",
    "build": "rm -rf ./dist && tsc",
    "build:prod": "NODE_OPTIONS=--max_old_space_size=4096 npx prisma generate && rimraf ./dist && tsc && npm prune --omit=dev",
    "start": "npx prisma migrate deploy && node dist/server.js",
    "dev": "ts-node-dev --poll src/server.ts",
    "dev:watch": "nodemon --watch src --exec ts-node src/server.ts",
    "cron:test": "jest src/jobs/__tests__/",
    "postinstall": "npm rebuild sharp --force --platform=linux --arch=x64 --libc=glibc && prisma generate && npx --yes puppeteer@22.15.0 browsers install chrome"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^5.18.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/k6": "^2.2.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^2.0.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
