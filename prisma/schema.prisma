generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  fullName                String
  email                   String                   @unique
  phone                   String?
  location                String?
  countryCode             String?                  @db.VarChar(2)
  profilePhoto            String?
  termsAndCondition       Boolean                  @default(false)
  password                String?
  provider                String?                  @default("local")
  providerId              String?                  @unique
  role                    ROLE                     @default(CLIENT)
  // Suspended users can't log in or use their token.
  status                  UserStatus               @default(ACTIVE)
  // Set when an admin creates the account with a password; cleared when the user changes it.
  mustChangePassword      Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  passwordResetTokens     PasswordResetToken[]
  verificationRequests    VerificationRequest[]
  verificationAgent       VerificationAgent?
  paystackCustomerCode    String?                  @unique
  paystackSubscriptions   PaystackSubscription[]
  stripeSubscriptions     StripeSubscription[]
  pricingSettings         PricingSettings[]
  premiumQuotesIssued     PremiumQuote[]           @relation("PremiumQuoteIssuer")
  monitoringSubscriptions MonitoringSubscription[]
  notifications           Notification[]           @relation("UserNotifications")
  fcmTokens               FCMToken[]
  notificationSettings    NotificationSettings?
  propertyInquiries       PropertyInquiry[]
  propertyFavorites       PropertyFavorite[]
  propertyRequests        PropertyRequest[]
  ProviderPriceVersion    ProviderPriceVersion[]

  @@index([role, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([used, expiresAt])
  @@index([createdAt])
}

enum ROLE {
  CLIENT
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum VERIFICATION_FREQUENCY {
  ONE_TIME
  MONTHLY
  QUARTERLY
}

enum VerificationTierCode {
  BASIC
  STANDARD
  PREMIUM
}

enum MonitoringInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum NgnRoundingRule {
  NEAREST_KOBO
}

enum ProviderPriceSyncStatus {
  PENDING
  READY
  FAILED
  INACTIVE
}

enum PremiumQuoteStatus {
  REQUESTED
  ISSUED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum MonitoringSubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAYMENT_FAILED
  DISABLED
  EXPIRED
}

enum SubscriptionPeriodStatus {
  PAID
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum SiteVisitStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionPurpose {
  INITIAL_PURCHASE
  PREMIUM_QUOTE
  RENEWAL
}

enum AgentAssignmentStatus {
  ASSIGNED
  ACCEPTED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETE
  REPORT_SUBMITTED
}

enum ReportReviewStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  verificationTypes VerificationType[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationType {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  slug        String  @unique
  description String?
  icon        String?

  verificationPlans      VerificationPlan[]
  verificationRequests   VerificationRequest[]
  checklistTemplateItems ChecklistTemplateItem[]
  notifications          Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model VerificationPlan {
  id                  String                 @id @default(cuid())
  verificationTypeId  String
  verificationType    VerificationType       @relation(fields: [verificationTypeId], references: [id], onDelete: Cascade)
  frequency           VERIFICATION_FREQUENCY
  name                String
  description         String?
  priceUsdCents       Int
  priceNgnKobo        Int
  paystackPlanCode    String?                @unique
  paystackNgnPlanCode String?                @unique
  stripePriceId       String?                @unique

  verificationRequests          VerificationRequest[]
  paystackSubscriptions         PaystackSubscription[]
  stripeSubscriptions           StripeSubscription[]
  providerPriceVersions         ProviderPriceVersion[]
  legacyMonitoringSubscriptions MonitoringSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([verificationTypeId, frequency])
  @@index([verificationTypeId])
}

model VerificationTier {
  id               String               @id @default(cuid())
  code             VerificationTierCode @unique
  name             String
  description      String
  features         String[]             @default([])
  priceUsdCents    Int?
  quoteRequired    Boolean              @default(false)
  minQuoteUsdCents Int?
  maxQuoteUsdCents Int?
  version          Int                  @default(1)
  active           Boolean              @default(true)

  verificationRequests  VerificationRequest[]
  reports               VerificationReport[]
  quotes                PremiumQuote[]
  providerPriceVersions ProviderPriceVersion[]
  transactions          Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, code])
}

model MonitoringPlan {
  id               String             @id @default(cuid())
  code             MonitoringInterval @unique
  name             String
  description      String?
  priceUsdCents    Int
  intervalCount    Int                @default(1)
  checksPerPeriod  Int
  reportsPerPeriod Int                @default(1)
  version          Int                @default(1)
  active           Boolean            @default(true)

  verificationRequests  VerificationRequest[]
  subscriptions         MonitoringSubscription[]
  periods               SubscriptionPeriod[]
  providerPriceVersions ProviderPriceVersion[]
  quotes                PremiumQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, code])
}

model PricingSettings {
  id           String          @id @default(cuid())
  version      Int             @unique
  usdToNgnRate Decimal         @db.Decimal(18, 8)
  roundingRule NgnRoundingRule @default(NEAREST_KOBO)
  active       Boolean         @default(false)
  updatedById  String?
  updatedBy    User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  quotes PremiumQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([updatedById])
}

model ProviderPriceVersion {
  id                       String                  @id @default(cuid())
  verificationTierId       String?
  verificationTier         VerificationTier?       @relation(fields: [verificationTierId], references: [id], onDelete: Restrict)
  monitoringPlanId         String?
  monitoringPlan           MonitoringPlan?         @relation(fields: [monitoringPlanId], references: [id], onDelete: Restrict)
  legacyVerificationPlanId String?
  legacyVerificationPlan   VerificationPlan?       @relation(fields: [legacyVerificationPlanId], references: [id], onDelete: Restrict)
  provider                 PaymentProvider
  providerProductId        String?
  providerPriceId          String?
  currency                 String                  @db.VarChar(3)
  amountMinor              Int
  usdAmountCents           Int
  version                  Int
  interval                 MonitoringInterval?
  intervalCount            Int?
  syncStatus               ProviderPriceSyncStatus @default(PENDING)
  syncError                String?
  activeForNewCheckout     Boolean                 @default(false)
  syncedById               String?
  syncedBy                 User?                   @relation(fields: [syncedById], references: [id], onDelete: SetNull)

  transactions  Transaction[]
  subscriptions MonitoringSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([verificationTierId, provider, version])
  @@unique([monitoringPlanId, provider, version])
  @@unique([legacyVerificationPlanId, provider, version])
  @@unique([provider, providerPriceId])
  @@index([provider, currency, activeForNewCheckout])
  @@index([syncStatus])
}

enum VerificationStatus {
  DRAFT
  QUOTE_REQUIRED
  PENDING_PAYMENT
  PAYMENT_FAILED
  SUBMITTED
  IN_PROGRESS
  AWAITING_RENEWAL
  COMPLETED
  CANCELLED
}

enum PropertyStatus {
  PENDING
  VERIFIED
  REJECTED
}

// The Explore Properties chips: Houses, Apartments, Land, Commercial.
enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
}

enum PaymentMethod {
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETE
}

enum DocumentType {
  VERIFICATION_DOCUMENT
  CHECKLIST_MEDIA
  REPORT_DOCUMENT
}

model VerificationRequest {
  id                      String             @id @default(cuid())
  userId                  String
  user                    User               @relation(fields: [userId], references: [id])
  verificationTypeId      String
  verificationType        VerificationType   @relation(fields: [verificationTypeId], references: [id])
  verificationPlanId      String?
  verificationPlan        VerificationPlan?  @relation(fields: [verificationPlanId], references: [id])
  verificationTierId      String?
  verificationTier        VerificationTier?  @relation(fields: [verificationTierId], references: [id], onDelete: SetNull)
  monitoringPlanId        String?
  monitoringPlan          MonitoringPlan?    @relation(fields: [monitoringPlanId], references: [id], onDelete: SetNull)
  recurringConsent        Boolean            @default(false)
  recurringConsentAt      DateTime?
  status                  VerificationStatus @default(DRAFT)
  details                 Json
  intendedUse             String?
  additionalNote          String?
  notifyOnInspectionStart Boolean            @default(true)
  notifyOnReportReady     Boolean            @default(true)

  documents               Document[]
  transactions            Transaction[]
  reports                 VerificationReport[]
  agentAssignment         AgentAssignment?
  paystackSubscription    PaystackSubscription?
  stripeSubscription      StripeSubscription?
  premiumQuotes           PremiumQuote[]
  monitoringSubscriptions MonitoringSubscription[]
  subscriptionPeriods     SubscriptionPeriod[]
  siteVisits              SiteVisit[]
  notifications           Notification[]
  activityLogs            ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationTypeId])
  @@index([verificationTierId])
  @@index([monitoringPlanId])
}

model Document {
  id                    String                     @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest        @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  verificationReportId  String?
  verificationReport    VerificationReport?        @relation(fields: [verificationReportId], references: [id], onDelete: SetNull)
  checklistItemId       String?
  checklistItem         VerificationChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  siteVisitId           String?
  siteVisit             SiteVisit?                 @relation(fields: [siteVisitId], references: [id], onDelete: SetNull)
  documentType          DocumentType               @default(VERIFICATION_DOCUMENT)
  url                   String
  fileName              String
  fileType              String
  fileSizeBytes         Int

  createdAt DateTime @default(now())

  @@index([verificationRequestId])
  @@index([verificationReportId])
  @@index([checklistItemId])
  @@index([siteVisitId])
  @@index([verificationReportId, documentType])
}

model ChecklistTemplateItem {
  id                 String           @id @default(cuid())
  verificationTypeId String
  verificationType   VerificationType @relation(fields: [verificationTypeId], references: [id], onDelete: Cascade)
  label              String
  requiresMedia      Boolean          @default(true)
  sortOrder          Int

  @@unique([verificationTypeId, sortOrder])
  @@index([verificationTypeId])
}

model VerificationAgent {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  name          String
  phone         String?
  region        String?
  status        AgentStatus @default(ACTIVE)
  deactivatedAt DateTime?

  assignments AgentAssignment[]
  reports     VerificationReport[]
  properties  Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentAssignment {
  id                    String                @id @default(cuid())
  verificationRequestId String                @unique
  verificationRequest   VerificationRequest   @relation(fields: [verificationRequestId], references: [id])
  agentId               String
  agent                 VerificationAgent     @relation(fields: [agentId], references: [id])
  // The payment for the period this assignment covers.
  transactionId         String?
  transaction           Transaction?          @relation(fields: [transactionId], references: [id])
  status                AgentAssignmentStatus @default(ASSIGNED)
  progressPercent       Int?
  additionalNotes       String?
  scheduledAt           DateTime?
  completedAt           DateTime?

  checklistItems VerificationChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([transactionId])
}

model Property {
  id            String             @id @default(cuid())
  // Short public ID shown as "#000001".
  number        Int                @unique @default(autoincrement())
  name          String
  address       String
  propertyType  PropertyType       @default(HOUSE)
  area          String?
  city          String?
  country       String?
  priceAmount   BigInt             @default(0)
  priceCurrency String             @default("NGN")
  viewCount     Int                @default(0)
  coverImageUrl String?
  isPublished   Boolean            @default(false)
  status        PropertyStatus     @default(PENDING)
  verifiedAt    DateTime?
  description   String?
  bedrooms      Int?
  bathrooms     Int?
  sizeSqm       Float?
  yearBuilt     Int?
  amenities     PropertyAmenity[]  @default([])
  imageUrls     String[]           @default([])
  // Set by "Assign Property" on the Agent Profile page.
  agentId       String?
  agent         VerificationAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  // Set by "Delete Property": the row is kept but hidden everywhere.
  deletedAt     DateTime?
  inquiries     PropertyInquiry[]
  activityLogs  ActivityLog[]
  requests      PropertyRequest[]
  favorites     PropertyFavorite[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isPublished, createdAt])
  @@index([status])
  @@index([agentId])
  @@index([createdAt])
}

model VerificationChecklistItem {
  id                String              @id @default(cuid())
  agentAssignmentId String?
  agentAssignment   AgentAssignment?    @relation(fields: [agentAssignmentId], references: [id], onDelete: SetNull)
  // Set when the report is submitted, so the checklist outlives the assignment.
  reportId          String?
  report            VerificationReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  label             String
  sectionKey        String?
  result            Json?
  status            ChecklistItemStatus @default(PENDING)
  sortOrder         Int
  media             Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentAssignmentId])
  @@index([reportId])
}

model Transaction {
  id                       String                @id @default(cuid())
  verificationRequestId    String
  verificationRequest      VerificationRequest   @relation(fields: [verificationRequestId], references: [id])
  amountInCents            Int
  currency                 String                @default("NGN")
  provider                 PaymentProvider?
  purpose                  TransactionPurpose?
  verificationTierId       String?
  verificationTier         VerificationTier?     @relation(fields: [verificationTierId], references: [id], onDelete: SetNull)
  providerPriceVersionId   String?
  providerPriceVersion     ProviderPriceVersion? @relation(fields: [providerPriceVersionId], references: [id], onDelete: SetNull)
  premiumQuoteId           String?
  premiumQuote             PremiumQuote?         @relation(fields: [premiumQuoteId], references: [id], onDelete: SetNull)
  tierAmountUsdCents       Int?
  monitoringAmountUsdCents Int?
  totalUsdCents            Int?
  fxRate                   Decimal?              @db.Decimal(18, 8)
  fxRateVersion            Int?
  fxRoundingRule           NgnRoundingRule?
  pricingSnapshot          Json?
  method                   PaymentMethod
  status                   PaymentStatus         @default(PENDING)
  providerRef              String?               @unique
  stripeSubscriptionId     String?
  authorizationUrl         String?
  accessCode               String?
  paidAt                   DateTime?
  // When an agent was assigned to this paid period (for the pending-requests trend).
  assignedAt               DateTime?

  agentAssignments   AgentAssignment[]
  report             VerificationReport?
  subscriptionPeriod SubscriptionPeriod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, createdAt])
  @@index([stripeSubscriptionId, createdAt])
}

enum PaystackSubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAYMENT_FAILED
  DISABLED
  EXPIRED
}

enum StripeSubscriptionStatus {
  ACTIVE
  INACTIVE
}

model PaystackSubscription {
  id                    String                     @id @default(cuid())
  userId                String
  verificationRequestId String                     @unique
  verificationPlanId    String
  customerCode          String
  subscriptionCode      String                     @unique
  emailToken            String?
  status                PaystackSubscriptionStatus @default(ACTIVE)
  nextPaymentDate       DateTime?
  startedAt             DateTime?
  disabledAt            DateTime?

  user                User                @relation(fields: [userId], references: [id])
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  verificationPlan    VerificationPlan    @relation(fields: [verificationPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationPlanId])
  @@index([customerCode])
}

model StripeSubscription {
  id                    String                   @id @default(cuid())
  userId                String
  verificationRequestId String                   @unique
  verificationPlanId    String
  subscriptionId        String                   @unique
  status                StripeSubscriptionStatus @default(ACTIVE)
  currentPeriodEnd      DateTime?
  lastRenewalDate       DateTime?

  user                User                @relation(fields: [userId], references: [id])
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  verificationPlan    VerificationPlan    @relation(fields: [verificationPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationPlanId])
}

model VerificationReport {
  id                    String                      @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest         @relation(fields: [verificationRequestId], references: [id])
  verificationTierId    String?
  verificationTier      VerificationTier?           @relation(fields: [verificationTierId], references: [id], onDelete: SetNull)
  tierNameSnapshot      String?
  packageScopeSnapshot  Json?
  subscriptionPeriodId  String?                     @unique
  subscriptionPeriod    SubscriptionPeriod?         @relation(fields: [subscriptionPeriodId], references: [id], onDelete: SetNull)
  // The payment for the period this report covers (one report per paid period).
  transactionId         String?                     @unique
  transaction           Transaction?                @relation(fields: [transactionId], references: [id])
  submittedByAgentId    String
  agent                 VerificationAgent           @relation(fields: [submittedByAgentId], references: [id])
  summary               String?
  findings              Json?
  media                 Document[]
  reportUrl             String?
  viewedAt              DateTime?
  generatedAt           DateTime?
  reviewStatus          ReportReviewStatus          @default(PENDING)
  // The client's 1-5 star rating ("Leave a Comment"); resubmitting overwrites it.
  rating                Float?
  clientComment         String?
  ratedAt               DateTime?
  revisionNote          String?
  // Copied from the assignment, which is deleted after each recurring period.
  additionalNotes       String?
  checklistItems        VerificationChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewedAt])
  @@index([verificationRequestId, generatedAt])
}

model PremiumQuote {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  verificationTierId    String
  verificationTier      VerificationTier    @relation(fields: [verificationTierId], references: [id], onDelete: Restrict)
  monitoringPlanId      String?
  monitoringPlan        MonitoringPlan?     @relation(fields: [monitoringPlanId], references: [id], onDelete: SetNull)
  pricingSettingsId     String?
  pricingSettings       PricingSettings?    @relation(fields: [pricingSettingsId], references: [id], onDelete: SetNull)
  quoteUsdCents         Int?
  quoteNgnKobo          Int?
  usdToNgnRate          Decimal?            @db.Decimal(18, 8)
  rateVersion           Int?
  roundingRule          NgnRoundingRule?
  tierVersion           Int?
  scopeSummary          String?
  status                PremiumQuoteStatus  @default(REQUESTED)
  expiresAt             DateTime?
  issuedById            String?
  issuedBy              User?               @relation("PremiumQuoteIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  acceptedAt            DateTime?
  cancelledAt           DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, createdAt])
  @@index([status, expiresAt])
}

model MonitoringSubscription {
  id                       String                       @id @default(cuid())
  userId                   String
  user                     User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  verificationRequestId    String
  verificationRequest      VerificationRequest          @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  monitoringPlanId         String?
  monitoringPlan           MonitoringPlan?              @relation(fields: [monitoringPlanId], references: [id], onDelete: SetNull)
  legacyVerificationPlanId String?
  legacyVerificationPlan   VerificationPlan?            @relation(fields: [legacyVerificationPlanId], references: [id], onDelete: SetNull)
  providerPriceVersionId   String?
  providerPriceVersion     ProviderPriceVersion?        @relation(fields: [providerPriceVersionId], references: [id], onDelete: SetNull)
  provider                 PaymentProvider
  providerSubscriptionId   String?
  customerCode             String?
  emailToken               String?
  status                   MonitoringSubscriptionStatus @default(ACTIVE)
  planVersion              Int?
  interval                 MonitoringInterval?
  intervalCount            Int?
  priceUsdCents            Int?
  checksPerPeriod          Int?
  reportsPerPeriod         Int?
  consentAt                DateTime?
  startedAt                DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  disabledAt               DateTime?

  periods SubscriptionPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([verificationRequestId, createdAt])
  @@index([userId])
  @@index([monitoringPlanId])
  @@index([legacyVerificationPlanId])
  @@index([status, currentPeriodEnd])
}

model SubscriptionPeriod {
  id                       String                   @id @default(cuid())
  verificationRequestId    String
  verificationRequest      VerificationRequest      @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  monitoringSubscriptionId String
  monitoringSubscription   MonitoringSubscription   @relation(fields: [monitoringSubscriptionId], references: [id], onDelete: Restrict)
  monitoringPlanId         String?
  monitoringPlan           MonitoringPlan?          @relation(fields: [monitoringPlanId], references: [id], onDelete: SetNull)
  paidTransactionId        String                   @unique
  paidTransaction          Transaction              @relation(fields: [paidTransactionId], references: [id], onDelete: Restrict)
  status                   SubscriptionPeriodStatus @default(PAID)
  periodStart              DateTime
  periodEnd                DateTime
  requiredSiteVisits       Int
  completedSiteVisits      Int                      @default(0)
  requiredReports          Int                      @default(1)
  reportCount              Int                      @default(0)
  delayResolution          String?

  siteVisits SiteVisit[]
  report     VerificationReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, periodStart])
  @@index([monitoringSubscriptionId, periodStart])
  @@index([status, periodEnd])
}

model SiteVisit {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)
  subscriptionPeriodId  String?
  subscriptionPeriod    SubscriptionPeriod? @relation(fields: [subscriptionPeriodId], references: [id], onDelete: Restrict)
  visitNumber           Int
  status                SiteVisitStatus     @default(PENDING)
  scheduledAt           DateTime?
  completedAt           DateTime?
  location              Json?
  checklist             Json?
  documents             Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionPeriodId, visitNumber])
  @@index([verificationRequestId, status])
  @@index([scheduledAt])
}

model WebhookEvent {
  id          String  @id @default(cuid())
  eventId     String  @unique
  integration String
  data        Json?
  verified    Boolean @default(false)
  processed   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([integration, processed])
}

model Notification {
  id                    String             @id @default(uuid())
  userId                String
  type                  NotificationType
  serviceId             String?
  verificationTypeId    String?
  verificationRequestId String?
  createdAt             DateTime           @default(now())
  notificationStatus    NotificationStatus @default(PENDING)
  body                  String?
  meta                  Json?
  sentAt                DateTime?
  title                 String?
  read                  Boolean            @default(false)

  user                User                 @relation("UserNotifications", fields: [userId], references: [id])
  service             Service?             @relation(fields: [serviceId], references: [id])
  verificationType    VerificationType?    @relation(fields: [verificationTypeId], references: [id])
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id])

  @@index([userId, createdAt])
  @@index([serviceId])
  @@index([verificationTypeId])
  @@index([verificationRequestId])
}

model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  // Email and push are on until the user turns them off.
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  push      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  USER_REGISTERED
  USER_LOGIN
  PAYMENT_RECEIVED
  FORGOT_PASSWORD
  VERIFICATION_REQUEST_CREATED
  REPORT_UPLOADED
  AGENT_ASSIGNED
  INSPECTION_STARTED
  // Activity feed only; nobody is notified.
  PROPERTY_ADDED
  // A purchase or consultation request changed status (client in-app notification).
  PROPERTY_REQUEST_UPDATED
  // A client submitted a purchase or consultation request (admin in-app notification).
  PROPERTY_REQUEST_CREATED
  // A property payment succeeded (client and admin) or failed (client); in-app only.
  PROPERTY_PAYMENT_RECEIVED
  PROPERTY_PAYMENT_FAILED
  // A verification payment (first or renewal) failed.
  PAYMENT_FAILED
  // A monthly or quarterly verification subscription was cancelled or ended.
  SUBSCRIPTION_ENDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model FCMToken {
  id         String   @id @default(uuid())
  userId     String?
  token      String   @unique
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// Admin dashboard "Recent activity" feed: one row per event.
model ActivityLog {
  id                    String               @id @default(cuid())
  type                  NotificationType
  verificationRequestId String?
  verificationRequest   VerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)
  subjectName           String
  // The client shown on the row (for PROPERTY_ADDED, the admin who added it).
  clientName            String?
  agentName             String?
  // PAYMENT_RECEIVED only, in kobo.
  amount                Int?
  propertyId            String?
  property              Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())

  @@index([createdAt])
}

enum PropertyAmenity {
  SWIMMING_POOL
  PARKING
  SECURITY
  GENERATOR
  GARDEN
  GYM
  AIR_CONDITIONING
  ELEVATOR
  ROAD_ACCESS
}

model PropertyInquiry {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyFavorite {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
  @@index([propertyId])
}

enum PropertyRequestType {
  PURCHASE
  CONSULTATION
}

// The purchase progress steps. Admins move a request through them; payments don't.
enum PropertyRequestStatus {
  SUBMITTED
  CONSULTATION
  IN_PROGRESS
  OWNERSHIP_TRANSFER
  COMPLETED
  CANCELLED
}

enum PropertyPaymentStatus {
  READY
  PROCESSING
  SUCCESSFUL
  FAILED
}

enum PropertyPaymentMethod {
  CARD
  BANK_TRANSFER
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
}

// "Purchase Property" or "Request Consultation" on a listing. One open request per type,
// property and client.
model PropertyRequest {
  id         String                @id @default(cuid())
  // e.g. "BF-PUR-203948"; the payment reuses the number ("BF-PAY-203948").
  reference  String                @unique
  type       PropertyRequestType
  status     PropertyRequestStatus @default(SUBMITTED)
  propertyId String
  property   Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  updates   PropertyRequestUpdate[]
  payment   PropertyPayment?
  documents PropertyRequestDocument[]

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

// What a "Purchase Updates" card is labelled as.
enum PropertyUpdateKind {
  PROGRESS
  MILESTONE
  NOTICE
}

// "Purchase Updates": every status change, payment result and admin notice, newest last.
model PropertyRequestUpdate {
  id        String                @id @default(cuid())
  requestId String
  request   PropertyRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status    PropertyRequestStatus
  kind      PropertyUpdateKind    @default(PROGRESS)
  // The card title; status changes use the status label.
  title     String?
  // The admin's note, a notice's message or a payment result.
  note      String?
  createdAt DateTime              @default(now())

  @@index([requestId])
}

// The one payment for a purchase, created when the request moves to IN_PROGRESS for the
// property's listed price. Retries and method changes reuse this row.
model PropertyPayment {
  id           String                 @id @default(cuid())
  reference    String                 @unique
  requestId    String                 @unique
  request      PropertyRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // In kobo (or the currency's smallest unit). BigInt: listing prices overflow Int in kobo.
  amountInKobo BigInt
  currency     String                 @default("NGN")
  status       PropertyPaymentStatus  @default(READY)
  provider     PaymentProvider?
  method       PropertyPaymentMethod?
  // The latest checkout attempt's Paystack reference or Stripe session id.
  providerRef  String?
  checkoutUrl  String?
  paidAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([status])
}

// Replays the first response for a repeated Idempotency-Key, so a retried payment request
// can't start a second checkout.
model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String
  userId     String
  // Method and path, e.g. "POST /api/v1/client/property-requests/abc/payment/paystack".
  route      String
  // Null while the first request is still running.
  statusCode Int?
  body       Json?
  createdAt  DateTime @default(now())

  @@unique([userId, route, key])
  @@index([createdAt])
}

enum PropertyDocumentSource {
  // Shared with the client by an admin ("Available documents").
  BONAFIDE
  // Uploaded by the client ("Submitted documents").
  CLIENT
}

// A purchase document, stored privately in Cloudinary and opened with short-lived signed links.
model PropertyRequestDocument {
  id            String                 @id @default(cuid())
  requestId     String
  request       PropertyRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name          String
  source        PropertyDocumentSource
  fileName      String
  // The MIME type, e.g. "application/pdf".
  fileType      String
  fileSizeBytes Int
  // Cloudinary's identifiers for the private file; needed to sign links.
  publicId      String
  resourceType  String
  format        String
  createdAt     DateTime               @default(now())

  @@index([requestId])
}
