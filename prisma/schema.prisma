generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  fullName              String
  email                 String                 @unique
  phone                 String?
  location              String?
  profilePhoto          String?
  termsAndCondition     Boolean                @default(false)
  password              String?
  provider              String?                @default("local")
  providerId            String?                @unique
  role                  ROLE                   @default(CLIENT)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  passwordResetTokens   PasswordResetToken[]
  verificationRequests  VerificationRequest[]
  verificationAgent     VerificationAgent?
  paystackCustomerCode  String?                @unique
  paystackSubscriptions PaystackSubscription[]
  stripeSubscriptions   StripeSubscription[]
  notifications         Notification[]         @relation("UserNotifications")
  fcmTokens             FCMToken[]
  notificationSettings  NotificationSettings?

  @@index([role, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([used, expiresAt])
  @@index([createdAt])
}

enum ROLE {
  CLIENT
  ADMIN
  AGENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum VERIFICATION_FREQUENCY {
  ONE_TIME
  MONTHLY
  QUARTERLY
}

enum AgentAssignmentStatus {
  ASSIGNED
  ACCEPTED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETE
  REPORT_SUBMITTED
}

enum ReportReviewStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  verificationTypes VerificationType[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationType {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  slug        String  @unique
  description String?
  icon        String?

  verificationPlans      VerificationPlan[]
  verificationRequests   VerificationRequest[]
  checklistTemplateItems ChecklistTemplateItem[]
  notifications          Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model VerificationPlan {
  id                 String                 @id @default(cuid())
  verificationTypeId String
  verificationType   VerificationType       @relation(fields: [verificationTypeId], references: [id], onDelete: Cascade)
  frequency          VERIFICATION_FREQUENCY
  name               String
  description        String?
  priceInCents       Int
  currency           String                 @default("NGN")
  paystackPlanCode   String?                @unique
  stripePriceId      String?                @unique

  verificationRequests  VerificationRequest[]
  paystackSubscriptions PaystackSubscription[]
  stripeSubscriptions   StripeSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([verificationTypeId, frequency])
  @@index([verificationTypeId])
}

enum VerificationStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  SUBMITTED
  IN_PROGRESS
  AWAITING_RENEWAL
  COMPLETED
  CANCELLED
}

enum PropertyStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PaymentMethod {
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETE
}

model VerificationRequest {
  id                      String             @id @default(cuid())
  userId                  String
  user                    User               @relation(fields: [userId], references: [id])
  verificationTypeId      String
  verificationType        VerificationType   @relation(fields: [verificationTypeId], references: [id])
  verificationPlanId      String?
  verificationPlan        VerificationPlan?  @relation(fields: [verificationPlanId], references: [id])
  status                  VerificationStatus @default(DRAFT)
  details                 Json
  additionalNote          String?
  notifyOnInspectionStart Boolean            @default(true)
  notifyOnReportReady     Boolean            @default(true)

  documents            Document[]
  transactions         Transaction[]
  reports              VerificationReport[]
  agentAssignment      AgentAssignment?
  paystackSubscription PaystackSubscription?
  stripeSubscription   StripeSubscription?
  notifications        Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationTypeId])
}

model Document {
  id                    String                     @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest        @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  verificationReportId  String?
  verificationReport    VerificationReport?        @relation(fields: [verificationReportId], references: [id], onDelete: SetNull)
  checklistItemId       String?
  checklistItem         VerificationChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  url                   String
  fileName              String
  fileType              String
  fileSizeBytes         Int

  createdAt DateTime @default(now())

  @@index([verificationRequestId])
  @@index([verificationReportId])
  @@index([checklistItemId])
}

model ChecklistTemplateItem {
  id                 String           @id @default(cuid())
  verificationTypeId String
  verificationType   VerificationType @relation(fields: [verificationTypeId], references: [id], onDelete: Cascade)
  label              String
  requiresMedia      Boolean          @default(true)
  sortOrder          Int

  @@unique([verificationTypeId, sortOrder])
  @@index([verificationTypeId])
}

model VerificationAgent {
  id     String      @id @default(cuid())
  userId String      @unique
  user   User        @relation(fields: [userId], references: [id])
  name   String
  phone  String?
  region String?
  status AgentStatus @default(ACTIVE)

  assignments AgentAssignment[]
  reports     VerificationReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentAssignment {
  id                    String                @id @default(cuid())
  verificationRequestId String                @unique
  verificationRequest   VerificationRequest   @relation(fields: [verificationRequestId], references: [id])
  agentId               String
  agent                 VerificationAgent     @relation(fields: [agentId], references: [id])
  // The payment for the period this assignment covers.
  transactionId         String?
  transaction           Transaction?          @relation(fields: [transactionId], references: [id])
  status                AgentAssignmentStatus @default(ASSIGNED)
  progressPercent       Int?
  additionalNotes       String?
  scheduledAt           DateTime?
  completedAt           DateTime?

  checklistItems VerificationChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([transactionId])
}

model Property {
  id            String         @id @default(cuid())
  name          String
  address       String
  title         String         @default("")
  propertyType  PropertyType   @default(RESIDENTIAL)
  area          String?
  city          String?
  country       String?
  priceAmount   Int            @default(0)
  priceCurrency String         @default("NGN")
  viewCount     Int            @default(0)
  coverImageUrl String?
  isPublished   Boolean        @default(false)
  status        PropertyStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isPublished, createdAt])
  @@index([status])
  @@index([createdAt])
}

model VerificationChecklistItem {
  id                String              @id @default(cuid())
  agentAssignmentId String?
  agentAssignment   AgentAssignment?    @relation(fields: [agentAssignmentId], references: [id], onDelete: SetNull)
  // Set when the report is submitted, so the checklist outlives the assignment.
  reportId          String?
  report            VerificationReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  label             String
  status            ChecklistItemStatus @default(PENDING)
  sortOrder         Int
  media             Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentAssignmentId])
  @@index([reportId])
}

model Transaction {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  amountInCents         Int
  currency              String              @default("NGN")
  method                PaymentMethod
  status                PaymentStatus       @default(PENDING)
  providerRef           String?             @unique
  stripeSubscriptionId  String?
  authorizationUrl      String?
  accessCode            String?
  paidAt                DateTime?

  agentAssignments AgentAssignment[]
  report           VerificationReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, createdAt])
  @@index([stripeSubscriptionId, createdAt])
}

enum PaystackSubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAYMENT_FAILED
  DISABLED
  EXPIRED
}

enum StripeSubscriptionStatus {
  ACTIVE
  INACTIVE
}

model PaystackSubscription {
  id                    String                     @id @default(cuid())
  userId                String
  verificationRequestId String                     @unique
  verificationPlanId    String
  customerCode          String
  subscriptionCode      String                     @unique
  emailToken            String?
  status                PaystackSubscriptionStatus @default(ACTIVE)
  nextPaymentDate       DateTime?
  startedAt             DateTime?
  disabledAt            DateTime?

  user                User                @relation(fields: [userId], references: [id])
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  verificationPlan    VerificationPlan    @relation(fields: [verificationPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationPlanId])
  @@index([customerCode])
}

model StripeSubscription {
  id                    String                   @id @default(cuid())
  userId                String
  verificationRequestId String                   @unique
  verificationPlanId    String
  subscriptionId        String                   @unique
  status                StripeSubscriptionStatus @default(ACTIVE)
  currentPeriodEnd      DateTime?
  lastRenewalDate       DateTime?

  user                User                @relation(fields: [userId], references: [id])
  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  verificationPlan    VerificationPlan    @relation(fields: [verificationPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationPlanId])
}

model VerificationReport {
  id                    String                      @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest         @relation(fields: [verificationRequestId], references: [id])
  // The payment for the period this report covers (one report per paid period).
  transactionId         String?                     @unique
  transaction           Transaction?                @relation(fields: [transactionId], references: [id])
  submittedByAgentId    String
  agent                 VerificationAgent           @relation(fields: [submittedByAgentId], references: [id])
  summary               String?
  findings              Json?
  media                 Document[]
  reportUrl             String?
  viewedAt              DateTime?
  generatedAt           DateTime?
  reviewStatus          ReportReviewStatus          @default(PENDING)
  rating                Float?
  revisionNote          String?
  // Copied from the assignment, which is deleted after each recurring period.
  additionalNotes       String?
  checklistItems        VerificationChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewedAt])
  @@index([verificationRequestId, generatedAt])
}

model WebhookEvent {
  id          String  @id @default(cuid())
  eventId     String  @unique
  integration String
  data        Json?
  verified    Boolean @default(false)
  processed   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([integration, processed])
}

model Notification {
  id                    String             @id @default(uuid())
  userId                String
  type                  NotificationType
  serviceId             String?
  verificationTypeId    String?
  verificationRequestId String?
  createdAt             DateTime           @default(now())
  notificationStatus    NotificationStatus @default(PENDING)
  body                  String?
  meta                  Json?
  sentAt                DateTime?
  title                 String?
  read                  Boolean            @default(false)

  user                User                 @relation("UserNotifications", fields: [userId], references: [id])
  service             Service?             @relation(fields: [serviceId], references: [id])
  verificationType    VerificationType?    @relation(fields: [verificationTypeId], references: [id])
  verificationRequest VerificationRequest? @relation(fields: [verificationRequestId], references: [id])

  @@index([userId, createdAt])
  @@index([serviceId])
  @@index([verificationTypeId])
  @@index([verificationRequestId])
}

model NotificationSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     Boolean  @default(false)
  sms       Boolean  @default(false)
  push      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  USER_REGISTERED
  USER_LOGIN
  PAYMENT_RECEIVED
  FORGOT_PASSWORD
  VERIFICATION_REQUEST_CREATED
  REPORT_UPLOADED
  AGENT_ASSIGNED
  INSPECTION_STARTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model FCMToken {
  id         String   @id @default(uuid())
  userId     String?
  token      String   @unique
  lastSeenAt DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}
