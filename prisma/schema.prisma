generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  termsAndCondition   Boolean              @default(false)
  password            String?
  provider            String?              @default("local")
  providerId          String?              @unique
  role                ROLE                 @default(CLIENT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  verificationRequests VerificationRequest[]

  @@index([role, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([used, expiresAt])
  @@index([createdAt])
}

enum ROLE {
  CLIENT
  ADMIN
  AGENT
}

enum VERIFICATION_FREQUENCY {
  ONE_TIME
  MONTHLY
  QUARTERLY
}

model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  verificationTypes VerificationType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationType {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  slug        String  @unique
  description String?
  icon        String?

  verificationPlans VerificationPlan[]
  verificationRequests VerificationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
}

model VerificationPlan {
  id                 String                 @id @default(cuid())
  verificationTypeId String
  verificationType   VerificationType       @relation(fields: [verificationTypeId], references: [id], onDelete: Cascade)
  frequency          VERIFICATION_FREQUENCY
  name               String
  description        String?
  priceInCents       Int
  currency           String                 @default("NGN")

  verificationRequests VerificationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([verificationTypeId, frequency])
  @@index([verificationTypeId])
}

enum VerificationStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  PAYPAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model VerificationRequest {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  verificationTypeId  String
  verificationType    VerificationType    @relation(fields: [verificationTypeId], references: [id])
  verificationPlanId  String?
  verificationPlan    VerificationPlan?   @relation(fields: [verificationPlanId], references: [id])
  status              VerificationStatus  @default(DRAFT)
  details             Json
  additionalNote      String?

  documents           Document[]
  transaction         Transaction?
  report              VerificationReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([verificationTypeId])
}

model Document {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  url                   String
  fileName              String
  fileType              String
  fileSizeBytes         Int

  createdAt DateTime @default(now())

  @@index([verificationRequestId])
}

model Transaction {
  id                    String              @id @default(cuid())
  verificationRequestId String              @unique
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  amountInCents         Int
  currency              String              @default("NGN")
  method                PaymentMethod
  status                PaymentStatus       @default(PENDING)
  providerRef           String?
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationReport {
  id                    String              @id @default(cuid())
  verificationRequestId String              @unique
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id])
  summary               String?
  findings              Json?
  reportUrl             String?
  generatedAt           DateTime?
  viewedAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewedAt])
}
