NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/bonafide

JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/client/auth/google/callback

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_SECRET_KEY=your-facebook-client-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/client/auth/facebook/callback

LOG_LEVEL=info