NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/bonafide

JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Social sign-in (POST /client/auth/google/token and /facebook/token)
GOOGLE_CLIENT_ID=your-google-client-id
# Optional: more Google client IDs whose ID tokens POST /client/auth/google/token accepts
# (e.g. separate iOS/Android client IDs), comma-separated.
GOOGLE_ADDITIONAL_CLIENT_IDS=

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_SECRET_KEY=your-facebook-client-secret
# Optional: Graph API version used by POST /client/auth/facebook/token (default v21.0)
FACEBOOK_GRAPH_API_VERSION=v21.0

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

REDIS_URL=redis://localhost:6379
# Set to false when running workers separately with `npm run worker`
RUN_WORKERS=true
BULLMQ_PREFIX=bonafide
BULLMQ_JOB_ATTEMPTS=5
NOTIFICATION_EVENT_CONCURRENCY=5
NOTIFICATION_DELIVERY_CONCURRENCY=10

ZEPTO_URL=api.zeptomail.com
ZEPTO_TOKEN=your-zeptomail-token
ZEPTO_FROM_EMAIL=noreply@example.com
ZEPTO_FROM_NAME=Bonafide
# ZeptoMail template keys. USER_REGISTERED, FORGOT_PASSWORD and PAYMENT_RECEIVED
# fall back to the existing templates when unset; the rest must be set.
ZEPTO_TEMPLATE_USER_REGISTERED=
ZEPTO_TEMPLATE_FORGOT_PASSWORD=
ZEPTO_TEMPLATE_PAYMENT_RECEIVED=
ZEPTO_TEMPLATE_PAYMENT_RECEIVED_ADMIN=
ZEPTO_TEMPLATE_VERIFICATION_REQUEST_CREATED=
ZEPTO_TEMPLATE_VERIFICATION_REQUEST_CREATED_ADMIN=
ZEPTO_TEMPLATE_REPORT_UPLOADED=
ZEPTO_TEMPLATE_REPORT_UPLOADED_ADMIN=
ZEPTO_TEMPLATE_AGENT_ASSIGNED=
ZEPTO_TEMPLATE_AGENT_ASSIGNED_AGENT=
ZEPTO_TEMPLATE_INSPECTION_STARTED=
ZEPTO_TEMPLATE_INSPECTION_STARTED_ADMIN=

LOG_LEVEL=info